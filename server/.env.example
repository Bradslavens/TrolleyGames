# Copy this file to .env and fill in real values. .env is gitignored.

# Port the server listens on (Render sets this automatically).
PORT=3001

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — without it, sessions reset on every restart.
JWT_SECRET=

# Comma-separated list of front-end origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://trolleygames-2.onrender.com

# Optional: path to the SQLite database file.
DB_PATH=./users.db
